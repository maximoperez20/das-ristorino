# ═══════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - Portal Ristorino
# ═══════════════════════════════════════════════════════════════

# OpenAI API Key (requerida para generación de contenido con IA)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui

# OpenAI Model (opcional, por defecto: gpt-4)
# Opciones: gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# OpenAI Timeout en segundos (opcional, por defecto: 60)
OPENAI_TIMEOUT=60

# ═══════════════════════════════════════════════════════════════
# INSTRUCCIONES:
# 1. Copia este archivo como .env (sin .example)
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit del archivo .env
# ═══════════════════════════════════════════════════════════════
